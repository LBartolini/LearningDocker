test -f /.configured && exit 0

uci -q batch <<-EOF >/dev/null
  #set firewall.@include[0].reload='1'
  
  add firewall zone   
  set firewall.@zone[-1]=zone
  set firewall.@zone[-1].name='internet'
  set firewall.@zone[-1].network='internet'
  set firewall.@zone[-1].input='ACCEPT'
  set firewall.@zone[-1].output='ACCEPT'
  set firewall.@zone[-1].forward='ACCEPT'
  commit firewall.@zone[-1]

  add firewall zone
  set firewall.@zone[-1]=zone
  set firewall.@zone[-1].name='office'
  set firewall.@zone[-1].network='office'
  set firewall.@zone[-1].input='ACCEPT'
  set firewall.@zone[-1].output='ACCEPT'
  set firewall.@zone[-1].forward='ACCEPT'
  commit firewall.@zone[-1]

  # Forwarding between zones
  add firewall forwarding
  set firewall.@forwarding[-1].src='office'
  set firewall.@forwarding[-1].dest='internet'
  add firewall forwarding
  set firewall.@forwarding[-1].src='internet'
  set firewall.@forwarding[-1].dest='office'

  # nat
  add firewall nat
  set firewall.@nat[-1].target='SNAT'
  set firewall.@nat[-1].src='office'
  set firewall.@nat[-1].name='source nat for external networks'
  set firewall.@nat[-1].snat_ip='172.29.0.1'

  commit firewall
EOF

touch /.configured
  
exit 0